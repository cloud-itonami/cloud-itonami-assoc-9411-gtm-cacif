;; nbb reads this file. It does NOT read deps.edn or bb.edn, and
;; tools/gen_kotoba.cljs is run as a bare `kbb --backend sci tools/gen_kotoba.cljk`, so the
;; kotoba.lang.text coordinate declared only in deps.edn is invisible to it --
;; a coordinate the runner cannot see is not a declaration (ADR-2609093000).
;;
;; :paths and the sha below are COPIED from deps.edn, not chosen here.
{:paths ["src"]
 :deps {io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.text"}}}
