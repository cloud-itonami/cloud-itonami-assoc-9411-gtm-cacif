(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
    (= i 0) 2
    (= i 1) 1
    (= i 2) 2
    (= i 3) 2
    (= i 4) 1
    (= i 5) 2
    (= i 6) 2
    (= i 7) 2
    (= i 8) 2
    (= i 9) 1
    (= i 10) 1
    (= i 11) 2
    (= i 12) 1
    (= i 13) 2
    (= i 14) 2
    (= i 15) 2
    (= i 16) 1
    :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "history")
          :else (option-none-of [:option :string]))
      (= i 1) (cond
          (= t 0) (option-some-of [:option :string] "history")
          :else (option-none-of [:option :string]))
      (= i 2) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "history")
          :else (option-none-of [:option :string]))
      (= i 3) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "statute")
          :else (option-none-of [:option :string]))
      (= i 4) (cond
          (= t 0) (option-some-of [:option :string] "statute")
          :else (option-none-of [:option :string]))
      (= i 5) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "history")
          :else (option-none-of [:option :string]))
      (= i 6) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "history")
          :else (option-none-of [:option :string]))
      (= i 7) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "statute")
          :else (option-none-of [:option :string]))
      (= i 8) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "statute")
          :else (option-none-of [:option :string]))
      (= i 9) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 10) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 11) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "labor")
          :else (option-none-of [:option :string]))
      (= i 12) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 13) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "membership")
          :else (option-none-of [:option :string]))
      (= i 14) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "membership")
          :else (option-none-of [:option :string]))
      (= i 15) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "board")
          :else (option-none-of [:option :string]))
      (= i 16) (cond
          (= t 0) (option-some-of [:option :string] "contact")
          :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
    (string=? candidate "governance") 14
    (string=? candidate "history") 5
    (string=? candidate "statute") 4
    (string=? candidate "labor") 1
    (string=? candidate "membership") 2
    (string=? candidate "board") 1
    (string=? candidate "contact") 1
    :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
    (string=? candidate "governance") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 2 "id")
        (= i 2) (entry-field a 3 "id")
        (= i 3) (entry-field a 5 "id")
        (= i 4) (entry-field a 6 "id")
        (= i 5) (entry-field a 7 "id")
        (= i 6) (entry-field a 8 "id")
        (= i 7) (entry-field a 9 "id")
        (= i 8) (entry-field a 10 "id")
        (= i 9) (entry-field a 11 "id")
        (= i 10) (entry-field a 12 "id")
        (= i 11) (entry-field a 13 "id")
        (= i 12) (entry-field a 14 "id")
        (= i 13) (entry-field a 15 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "history") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 1 "id")
        (= i 2) (entry-field a 2 "id")
        (= i 3) (entry-field a 5 "id")
        (= i 4) (entry-field a 6 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "statute") (cond
        (= i 0) (entry-field a 3 "id")
        (= i 1) (entry-field a 4 "id")
        (= i 2) (entry-field a 7 "id")
        (= i 3) (entry-field a 8 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "labor") (cond
        (= i 0) (entry-field a 11 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "membership") (cond
        (= i 0) (entry-field a 13 "id")
        (= i 1) (entry-field a 14 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "board") (cond
        (= i 0) (entry-field a 15 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "contact") (cond
        (= i 0) (entry-field a 16 "id")
        :else (option-none-of [:option :string]))
    :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] "cloud-itonami-assoc-9411-gtm-cacif Wave 0 (ADR-2607141700): 17 CACIF entries -- 14 read directly from cacif.org.gt, 2 from an independent secondary document, 1 where cacif.org.gt contradicts itself. Extend `association.facts/catalog`, never fabricate an id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
